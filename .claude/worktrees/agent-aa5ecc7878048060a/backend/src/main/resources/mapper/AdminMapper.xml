<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reportapp.reportappbackend.mapper.AdminMapper">

    <select id="findByUsername" resultType="com.reportapp.reportappbackend.entity.Admin">
        SELECT id, username, password_hash, name, created_at, updated_at
        FROM admins
        WHERE username = #{username}
    </select>

</mapper>
